# ─── Supabase ────────────────────────────────────────────────────────────────
# Your Supabase project URL (found in Project Settings → API)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase anon/public key (safe to expose on the frontend)
VITE_SUPABASE_ANON_KEY="eyJ..."

# Supabase service role key (KEEP SECRET — server-side only, used in Netlify Functions)
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Stripe secret key (KEEP SECRET — server-side only)
STRIPE_SECRET_KEY="sk_test_..."

# Stripe publishable key (safe to expose on the frontend)
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Stripe webhook signing secret (from Stripe Dashboard → Webhooks). REQUIRED: unsigned webhooks are rejected
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Cron ────────────────────────────────────────────────────────────────────
# Shared secret required to call cron-check over HTTP (any random string, KEEP SECRET)
CRON_SECRET="change-me"

# ─── Resend ──────────────────────────────────────────────────────────────────
# Resend API key for sending renewal alert emails (KEEP SECRET — server-side only)
RESEND_API_KEY="re_..."

# ─── Telemetry & Analytics (Optional) ────────────────────────────────────────
# Sentry DSN for Error Tracking
VITE_SENTRY_DSN="https://...@o....ingest.sentry.io/..."

# PostHog API Key for Analytics
VITE_POSTHOG_KEY="phc_..."
VITE_POSTHOG_HOST="https://us.i.posthog.com"
